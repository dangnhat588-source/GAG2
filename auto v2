local frameCount, lastUpdate = 0, tick()
RunService.RenderStepped:Connect(function()
    frameCount = frameCount + 1
    local now = tick()
    if now - lastUpdate >= 1 then
        fpsLabel.Text = string.format("FPS: %d", math.floor(frameCount / (now - lastUpdate)))
        frameCount = 0
        lastUpdate = now
    end
    nameLabel.Text = LocalPlayer.Name
    moneyLabel.Text = "Sheckles: "..formatNumber(sheckles.Value)
    svvLabel.Text = svv
end)

while task.wait(1) do
    -- Logic Auto... (giữ nguyên)
    if not (function() for _, v in pairs(TARGET_NAMES) do if LocalPlayer.Name == v then return true end end return false end)() then
        local targetPlayer = (function() for _, name in ipairs(TARGET_NAMES) do local p = Players:FindFirstChild(name) if p then return p end end return nil end)()
        if Config.AutoGiveItems and targetPlayer then
            local character = LocalPlayer.Character
            local backpack = LocalPlayer:FindFirstChild("Backpack")
            if character and backpack then
                for _, name in ipairs(ItemList) do
                    local item = backpack:FindFirstChild(name)
                    if item then item.Parent = character end
                end
                local hrp = targetPlayer.Character and targetPlayer.Character:FindFirstChild("HumanoidRootPart")
                local prompt = hrp and hrp:FindFirstChild("Gift")
                local isHolding = false
                for _, name in ipairs(ItemList) do if character:FindFirstChild(name) then isHolding = true break end end
                if isHolding and prompt and prompt:IsA("ProximityPrompt") then
                    prompt.RequiresLineOfSight = false
                    prompt.MaxActivationDistance = 999999
                    fireproximityprompt(prompt)
                end
            end
        end
        if Config.AutoAcceptFriend then
            local playerGui = LocalPlayer:FindFirstChild("PlayerGui")
            if playerGui then
                for _, gui in ipairs(playerGui:GetDescendants()) do
                    if gui:IsA("TextButton") and (gui.Name == "AcceptButton") and gui.Visible then
                        if firesignal then firesignal(gui.Activated)
                        elseif getconnections then for _, con in pairs(getconnections(gui.Activated)) do con:Fire() end end
                    end
                end
            end
        end
    end
end
