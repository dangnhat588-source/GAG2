local function formatNumber(n)
    local suffixes = {"","K","M","B","T","Qa","Qi","Sx","Sp","Oc","No","Dc"}
    n = tonumber(n) or 0
    local index = 1
    while n >= 1000 and index < #suffixes do n = n / 1000; index = index + 1 end
    if n >= 999.95 and index < #suffixes then n = 1; index = index + 1 end
    if index == 1 then return tostring(math.floor(n))
    elseif n >= 100 then return string.format("%.0f%s", n, suffixes[index])
    elseif n >= 10 then return string.format("%.1f%s", n, suffixes[index])
    else return string.format("%.2f%s", n, suffixes[index]) end
end

