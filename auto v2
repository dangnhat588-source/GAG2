local function formatNumber(n)
    local suffix = {"","K","M","B","T","Qa","Qi","Sx","Sp","Oc","No","Dc"}
    n = tonumber(n) or 0
    local i = 1
    while n >= 1000 and i < #suffix do n /= 1000; i += 1 end
    if n >= 999.95 and i < #suffix then n = 1; i += 1 end
    if i == 1 then return tostring(math.floor(n))
    elseif n >= 100 then return string.format("%.0f%s", n, suffix[i])
    elseif n >= 10 then return string.format("%.1f%s", n, suffix[i])
    else return string.format("%.2f%s", n, suffix[i]) end
end

