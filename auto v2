local function formatNumber(n)
    n = tonumber(n) or 0
    if n >= 1000000000000 then return string.format("%.2fT", n / 1000000000000)
    elseif n >= 1000000000 then return string.format("%.2fB", n / 1000000000)
    elseif n >= 1000000 then return string.format("%.2fM", n / 1000000)
    elseif n >= 1000 then return string.format("%.2fK", n / 1000)
    else return tostring(math.floor(n)) end
end

