--- 2. Helper Functions Mã Hóa
local function getDoubleBytes(value)
    local b = buffer.create(8)
    buffer.writef64(b, 0, value)
    local bytes = {}
    for i = 1, 8 do
        table.insert(bytes, buffer.readu8(b, i - 1))
    end
    return bytes
end

local function stringToBytes(str)
    local bytes = {}
    for i = 1, #str do
        table.insert(bytes, string.byte(str, i))
    end
    return bytes
end

-- 3. Xử lý sự kiện bấm nút Gửi
SendBtn.MouseButton1Click:Connect(function()
    local targetName = NameBox.Text
    local itemName = ItemBox.Text
    local itemCount = tonumber(CountBox.Text) or 1

    if targetName == "" or itemName == "" then
        StatusLabel.Text = "Vui lòng điền đủ thông tin!"
        StatusLabel.TextColor3 = Color3.fromRGB(255, 85, 85)
        return
    end

    StatusLabel.Text = "Đang tìm UserId..."
    StatusLabel.TextColor3 = Color3.fromRGB(255, 255, 85)

    -- Đổi Username thành UserId
    local userId
    local success, err = pcall(function()
        userId = Players:GetUserIdFromNameAsync(targetName)
    end)

    if not success or not userId then
        StatusLabel.Text = "Không tìm thấy người dùng!"
        StatusLabel.TextColor3 = Color3.fromRGB(255, 85, 85)
        return
    end

    -- Tạo chuỗi Byte IEEE-754 (Double) từ UserId
    local idBytes = getDoubleBytes(userId)
    
    -- Xây dựng Packet Buffer cho EGGS
    local packetData = {49, 1, 50}
    
    -- Thêm 8 byte UserId
    for _, byte in ipairs(idBytes) do
        table.insert(packetData, byte)
    end
    
    -- Header ItemKey + Độ dài tên Trứng
    local midHeader = {28, 5, 1, 28, 11, 7, 73, 116, 101, 109, 75, 101, 121, 11, #itemName}
    for _, byte in ipairs(midHeader) do
        table.insert(packetData, byte)
    end
    
    -- Tên Trứng (Byte String)
    local itemBytes = stringToBytes(itemName)
    for _, byte in ipairs(itemBytes) do
        table.insert(packetData, byte)
    end
    
    -- Count
    local countHeader = {11, 5, 67, 111, 117, 110, 116, 5, itemCount}
    for _, byte in ipairs(countHeader) do
        table.insert(packetData, byte)
    end

    -- Footer Danh mục Category: Eggs ({11, 8, 'Category', 11, 4, 'Eggs', 0, 0, 0})
    local footer = {11, 8, 67, 97, 116, 101, 103, 111, 114, 121, 11, 4, 69, 103, 103, 115, 0, 0, 0}
    for _, byte in ipairs(footer) do
        table.insert(packetData, byte)
    end

    -- Gửi dữ liệu tới Server
    local Event = ReplicatedStorage:WaitForChild("SharedModules"):WaitForChild("Packet"):WaitForChild("RemoteEvent")
    
    local sendBuffer = (function(bytes)
        local b = buffer.create(#bytes)
        for i = 1, #bytes do
            buffer.writeu8(b, i - 1, bytes[i])
        end
        return b
    end)(packetData)

    Event:FireServer(sendBuffer)

    StatusLabel.Text = "Đã gửi x" .. itemCount .. " " .. itemName .. " tới " .. targetName .. "!"
    StatusLabel.TextColor3 = Color3.fromRGB(85, 255, 85)
end)
